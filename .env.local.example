# ---------------------------------------------------------------------------
# ElectronIx Trace website — environment
# Copy to .env.local for local development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Canonical origin. Used for canonical URLs, sitemap, OG images and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://trace.electronix.co.in

# --- Supabase (lead capture) ----------------------------------------------
# Project URL. Safe to expose; it is in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never
# reference it from a client component. It bypasses row level security.
# Only /api/lead/verify needs this: flipping a row to confirmed must not be
# possible with the public key. Without it, double opt-in is disabled.
SUPABASE_SERVICE_ROLE_KEY=

# Leave both unset and the lead route logs submissions instead of storing them,
# so a preview deployment never silently loses an enquiry.

# --- Lead notification (Resend) -------------------------------------------
# Optional. Unset means no email is sent; the lead is still stored.
# Sends the confirmation email to the enquirer and the alert to you. Without
# it the enquiry is still stored, and the owner alert is sent immediately
# instead of waiting for a confirmation that can never arrive.
RESEND_API_KEY=
# A verified sender on your Resend domain, e.g. "Trace <leads@electronix.co.in>"
LEAD_NOTIFY_FROM=

# --- Analytics -------------------------------------------------------------
# Optional. GA4 mounts only when this is present, so the repo ships untracked.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML verification token (the content= value only).
NEXT_PUBLIC_GSC_VERIFICATION=
